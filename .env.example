# Copy to .env on the VPS and replace every placeholder before deploy.
# Use URL-safe secrets, e.g. `openssl rand -hex 32`.

POSTGRES_USER=escola
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=escola
DATABASE_URL=postgres://escola:replace-with-a-long-random-password@postgres:5432/escola

APP_DOMAIN=xadrez.example.pt
APP_BASE_URL=https://xadrez.example.pt
UPLOAD_DIR=/app/uploads
BACKUP_DIR=/app/uploads/backups
CLUB_NAME=Efanor

# Set only for the one-time seed command, then remove or blank it.
INITIAL_ADMIN_PASSWORD=replace-with-temporary-admin-password

CHESS_RESULTS_SYNC_ENABLED=true
CHESS_RESULTS_MIN_INTERVAL_MS=2500
CHESS_RESULTS_ROUND_POLL_MINUTES=60
FIDE_SYNC_ENABLED=true

# Optional offsite backup sync. Configure ops/rclone/rclone.conf first.
RCLONE_REMOTE=
BACKUP_SYNC_INTERVAL_SECONDS=3600
